{
  "name": "@grigora/commerce-adapter-razorpay",
  "version": "0.1.0",
  "description": "Razorpay Checkout adapter for Grigora Commerce embedded checkout.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public", "provenance": true },
  "repository": {
    "type": "git",
    "url": "https://github.com/Latracal-Solutions/grigora-commerce-sdk.git",
    "directory": "packages/adapter-razorpay"
  },
  "homepage": "https://github.com/Latracal-Solutions/grigora-commerce-sdk#readme",
  "keywords": ["grigora", "commerce", "ecommerce", "cart", "checkout", "sdk"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "@grigora/commerce-core": "^0.1.0" }
}
