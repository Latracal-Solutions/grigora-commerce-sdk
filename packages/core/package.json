{
  "name": "@grigora/commerce-core",
  "version": "0.1.0",
  "description": "Headless Grigora Commerce client: cart, checkout, products, orders, currency and typed events. Zero dependencies, SSR-safe.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public", "provenance": true },
  "repository": {
    "type": "git",
    "url": "https://github.com/Latracal-Solutions/grigora-commerce-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Latracal-Solutions/grigora-commerce-sdk#readme",
  "keywords": ["grigora", "commerce", "ecommerce", "cart", "checkout", "sdk"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {}
}
